{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CC Monitor",
  "version": "0.1.0",
  "identifier": "com.ccmonitor.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CC Monitor",
        "width": 900,
        "height": 600,
        "resizable": true,
        "center": true
      },
      {
        "label": "bar",
        "title": "CC Monitor Bar",
        "width": 600,
        "height": 36,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": false,
        "resizable": false,
        "center": true
      }
    ]
  }
}
